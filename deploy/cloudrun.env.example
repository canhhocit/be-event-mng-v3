# Cấu hình backend trên Cloud Run.
# Cả file được lưu thành 1 secret trong Secret Manager (tên: event-mng-env) và mount vào container
# tại /secrets/app.properties; Spring đọc nó như một file application.properties bổ sung.
#
#   cp deploy/cloudrun.env.example deploy/cloudrun.env     # file thật, đã nằm trong .gitignore
#   ./deploy/gcp.sh check-env                               # kiểm tra trước khi đẩy lên
#   ./deploy/gcp.sh env <PROJECT_ID>                        # tạo version secret mới + khởi động lại service
#
# Cú pháp .properties: KEY=value, không bọc giá trị trong dấu nháy, không dùng dấu \ trong giá trị.
# Không để dòng "KEY=" rỗng: giá trị rỗng sẽ ĐÈ lên giá trị mặc định. Không dùng thì comment cả dòng.
# BACKEND_URL và SEED_ENABLED do cloudbuild.yaml đặt sẵn, không khai báo ở đây.

# ---------- URL ----------
# Web khách hàng trên Vercel: dùng cho redirect sau thanh toán và link trong email.
FRONTEND_URL=https://ten-web-khach-hang.vercel.app
CORS_ALLOWED_ORIGINS=https://ten-web-khach-hang.vercel.app,https://ten-web-quan-tri.vercel.app

# ---------- Database (Neon, project Singapore) ----------
# Neon console > Connect > bật "Connection pooling" (host có chữ -pooler).
# Dạng JDBC, KHÔNG kèm user:password trong URL.
DATABASE_URL=jdbc:postgresql://ep-xxxx-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
POSTGRES_USER=neondb_owner
POSTGRES_PASSWORD=thay-bang-mat-khau-neon

# ---------- JWT (HS512, cần tối thiểu 64 ký tự) ----------
# Tạo mới bằng: openssl rand -hex 64
# KHÔNG dùng giá trị mặc định trong application.properties (repo đang public).
JWT_SECRET_KEY=thay-bang-chuoi-ngau-nhien

# ---------- Mail (Brevo) ----------
SMTP_USERNAME=xxxxxx@smtp-brevo.com
SMTP_PASSWORD=xsmtpsib-thay-bang-key-moi
MAIL_FROM=email-da-xac-thuc-tren-brevo@gmail.com
# Mail được gửi qua Brevo REST API. Nếu có API key riêng (xkeysib-...) thì bỏ comment dòng dưới,
# nếu không app dùng SMTP_PASSWORD làm API key.
# BREVO_API_KEY=xkeysib-...

# ---------- PayOS ----------
PAYOS_CLIENT_ID=thay-bang-client-id
PAYOS_API_KEY=thay-bang-api-key
PAYOS_CHECKSUM_KEY=thay-bang-checksum-key

# ---------- Cloudinary ----------
CLOUDINARY_CLOUD_NAME=thay-bang-cloud-name
CLOUDINARY_API_KEY=thay-bang-api-key
CLOUDINARY_API_SECRET=thay-bang-api-secret

# ---------- Deep link app mobile sau thanh toán ----------
PAYMENT_DEEP_LINK_SCHEME=customer
PAYMENT_DEEP_LINK_HOST=payment-status
PAYMENT_DEEP_LINK_PATH=/
